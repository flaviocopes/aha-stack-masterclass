---
import LayoutSite from '@layouts/LayoutSite.astro'
import {
  isValidData,
  createUser,
  loginUser,
  setCookieAndRedirectToDashboard,
  sendVerificationEmail,
  isLoggedIn,
  processTurnstile,
} from '@lib/auth'

let error = ''

if (await isLoggedIn(Astro.locals.pb, Astro.request)) {
  return Astro.redirect('/app/dashboard')
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData()
  const email = formData.get('email') as string
  const password = formData.get('password') as string
  const password_confirm = formData.get('password_confirm') as string

  const is_valid_turnstile = await processTurnstile(
    formData.get('cf-turnstile-response')?.toString() || ''
  )

  if (!is_valid_turnstile) {
    error = 'Request not authorized'
  } else {
    if (password !== password_confirm) {
      error = 'Passwords do not match'
    } else {
      if (!isValidData(email, password)) {
        error = 'Invalid data'
      } else {
        try {
          await createUser(Astro.locals.pb, email, password)
          await loginUser(Astro.locals.pb, email, password)
          await sendVerificationEmail(Astro.locals.pb, email)

          return setCookieAndRedirectToDashboard(Astro.locals.pb)
        } catch (e) {
          error = 'Could not create user'
        }
      }
    }
  }
}
---

<LayoutSite title='Signup'>
  <script
    is:inline
    src='https://challenges.cloudflare.com/turnstile/v0/api.js'
    defer
    async></script>

  <div class='w-full max-w-md mx-auto'>
    <a href='/'>
      <div
        class='rounded-lg bg-zinc-900 px-5 py-4 sm:py-2.5 text-xl sm:text-2xl md:text-3xl text-white uppercase text-center font-extrabold font-rounded'>
        SECRETPLAN
      </div>
    </a>
  </div>

  <div class='mx-auto mt-10 dark:text-white isolate gap-y-8 sm:mt-10 sm:mx-0'>
    <div
      class='flex flex-col justify-between max-w-md p-8 mx-auto border-4 rounded-3xl ring-1 ring-gray-200 xl:p-10 sm:mt-8'>
      <form method='post'>
        <p class='flex items-center justify-between mb-4'>
          <label for='email'>Email:</label>
          <input
            required
            type='email'
            name='email'
            id='email'
            class='w-2/3 p-1 text-black dark:text-white border dark:border-white rounded-lg'
          />
        </p>
        <p class='flex justify-between mb-4'>
          <label for='password'>Password:</label>
          <input
            required
            type='password'
            id='password'
            name='password'
            pattern='(?=.*\\d)(?=.*[a-z])(?=.*[A-Z]).{8,}'
            title='Must contain at least one number and one uppercase and lowercase letter, and at least 8 or more characters'
            class='w-2/3 p-1 text-black dark:text-white border dark:border-white rounded-lg'
          />
        </p>
        <p class='flex justify-between mb-4'>
          <label for='password_confirm' class='w-1/3'>Confirm password:</label>
          <input
            required
            type='password'
            id='password_confirm'
            name='password_confirm'
            pattern='(?=.*\\d)(?=.*[a-z])(?=.*[A-Z]).{8,}'
            class='w-2/3 p-1 text-black dark:text-white border dark:border-white rounded-lg self-baseline'
          />
        </p>

        <div
          class='cf-turnstile mt-6 flex justify-center'
          data-sitekey={import.meta.env.TURNSTILE_SITE_KEY ||
            process.env.TURNSTILE_SITE_KEY}>
        </div>

        <input
          type='submit'
          class='block w-full px-3 py-2 mt-8 text-sm font-semibold leading-6 text-center dark:text-white hover:text-white rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 ring-1 ring-inset ring-blue-200 hover:ring-blue-300 hover:bg-blue-600 cursor-pointer'
          value='Signup'
        />
      </form>

      <p class='mt-5 text-red-500'>
        {error}
      </p>

      <p class='mt-5 dark:text-white'>
        Already have an account? <a href='/login' class='underline'>Login</a>
      </p>
    </div>
  </div>
</LayoutSite>
